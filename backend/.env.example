PORT=5000
MONGO_URI=mongodb://localhost:27017/course-review
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads

# Cloudinary (khuyến nghị trên Render — file không mất khi redeploy)
# Tạo tại https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
